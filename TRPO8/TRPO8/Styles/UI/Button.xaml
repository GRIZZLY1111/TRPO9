<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Thickness x:Key="ButtonMargin">4</Thickness>
    <Thickness x:Key="TextBoxMargin">4</Thickness>
    <Thickness x:Key="DatePickerMargin">1</Thickness>
    <Thickness x:Key="BorderMargin">5</Thickness>
    <Thickness x:Key="LabelMargin">0</Thickness>

    <Style x:Key="StandardButton" TargetType="Button">
        <Setter Property="Margin" Value="{StaticResource ButtonMargin}"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
        <Setter Property="Content" Value="+"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BlueBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource VioletBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource StandardButton}">
        <Setter Property="Content" Value="🗑️"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource YellowBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource OrangeBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <Style x:Key="TextBoxWithMargin" TargetType="TextBox">
        <Setter Property="Margin" Value="{StaticResource TextBoxMargin}"/>
    </Style>

    <Style x:Key="DatePickerWithMargin" TargetType="DatePicker">
        <Setter Property="Margin" Value="{StaticResource DatePickerMargin}"/>
    </Style>

    <Style x:Key="BorderWithMargin" TargetType="Border">
        <Setter Property="Margin" Value="{StaticResource BorderMargin}"/>
    </Style>

    <Style x:Key="LabelWithMargin" TargetType="Label">
        <Setter Property="Margin" Value="{StaticResource LabelMargin}"/>
    </Style>
</ResourceDictionary>