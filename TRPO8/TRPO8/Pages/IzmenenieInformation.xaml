<Page x:Class="TRPO8.Pages.IzmenenieInformation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TRPO8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="IzmenenieInformation" Background="{DynamicResource WindowBackground}">

    <Grid>
        <StackPanel Orientation="Horizontal">
            <StackPanel>
                <Label Content="Фамилия пациента"/>
                <Label Content="Имя пациентов:"/>
                <Label Content="Отчество пациента:"/>
                <Label Content="Дата рождения:"/>
                <Label Content="Номер телефона:"/>
                <Button Click="IzmeneniePacientButton_Click" Content="Изменить" Style="{StaticResource StandardButton}"/>
                <Button Click="SbrosButton_Click" Content="Сбросить" Style="{StaticResource DeleteButton}"/>
                <Button Click="BackButton_Click" Content="Назад" Style="{StaticResource StandardButton}"/>
            </StackPanel>
            <StackPanel>
                <TextBox Text="{Binding IzmeneniePacient.LastName}" Style="{StaticResource TextBoxWithMargin}" Width="150px"/>
                <TextBox Text="{Binding IzmeneniePacient.Name}" Style="{StaticResource TextBoxWithMargin}" Width="150px"/>
                <TextBox Text="{Binding IzmeneniePacient.MiddleName}" Style="{StaticResource TextBoxWithMargin}" Width="150px"/>
                <DatePicker SelectedDate="{Binding IzmeneniePacient.Birthday}" Style="{StaticResource DatePickerWithMargin}" Width="150"/>
                <TextBox Text="{Binding IzmeneniePacient.PhoneNumber}" Style="{StaticResource TextBoxWithMargin}" Width="150px"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
