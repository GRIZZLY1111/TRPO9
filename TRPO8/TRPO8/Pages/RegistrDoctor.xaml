<Page x:Class="TRPO8.Pages.RegistrDoctor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TRPO8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegistrDoctor" Background="{DynamicResource WindowBackground}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Label Content="Фамилия:"/>
            <Label Content="Имя:"/>
            <Label Content="Отчество:"/>
            <Label Content="Специальность:"/>
            <Label Content="Пароль:"/>
            <Label Content="Подтверждение пароля:"/>
            <Button Click="RegisterButton_Click" Content="Зарегистрироваться" Style="{StaticResource StandardButton}"/>
            <Button Click="BackButton_Click" Content="Назад" Style="{StaticResource StandardButton}"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBox Text="{Binding ReadDoctor.LastName}" Style="{StaticResource TextBoxWithMargin}" Width="150px"/>
            <TextBox Text="{Binding ReadDoctor.Name}" Style="{StaticResource TextBoxWithMargin}" Width="150px"/>
            <TextBox Text="{Binding ReadDoctor.MiddleName}" Style="{StaticResource TextBoxWithMargin}" Width="150px"/>
            <TextBox Text="{Binding ReadDoctor.Specialisation}" Style="{StaticResource TextBoxWithMargin}" Width="150px"/>
            <TextBox Text="{Binding ReadDoctor.Password}" Style="{StaticResource TextBoxWithMargin}" Width="150px"/>
            <TextBox Text="{Binding PasswordDoctor.Password}" Style="{StaticResource TextBoxWithMargin}" Width="150px"/>
        </StackPanel>
    </Grid>
</Page>
