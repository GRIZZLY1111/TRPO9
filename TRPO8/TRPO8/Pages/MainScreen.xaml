<Page x:Class="TRPO8.Pages.MainScreen"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TRPO8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainScreen" Background="{DynamicResource WindowBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Style="{DynamicResource BorderWithMargin}">
            <StackPanel Orientation="Horizontal">
                <Button Click="CreatePacientButton_Click" Content="Создать пациента" Style="{StaticResource AddButton}" Width="250"/>
                <Button Click="StartPriemButton_Click" Content="Начать прием" Style="{StaticResource StandardButton}" Width="250"/>
                <Button Click="IzmeneniePacientButton_Click" Content="Изменить информацию" Style="{StaticResource StandardButton}" Width="250"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="0" Grid.Row="1" Width="310" Style="{DynamicResource BorderWithMargin}">
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <TextBlock Text="Идентификатор:" Style="{DynamicResource TextBlockWithMargin}"/>
                    <TextBlock Text="Фамилия:" Style="{DynamicResource TextBlockWithMargin}"/>
                    <TextBlock Text="Имя:" Style="{DynamicResource TextBlockWithMargin}"/>
                    <TextBlock Text="Отчество:" Style="{DynamicResource TextBlockWithMargin}"/>
                    <TextBlock Text="Специальность:" Style="{DynamicResource TextBlockWithMargin}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding CurrentDoctor.ID}" Style="{DynamicResource TextBlockWithMargin}"/>
                    <TextBlock Text="{Binding CurrentDoctor.LastName}" Style="{DynamicResource TextBlockWithMargin}"/>
                    <TextBlock Text="{Binding CurrentDoctor.Name}" Style="{DynamicResource TextBlockWithMargin}"/>
                    <TextBlock Text="{Binding CurrentDoctor.MiddleName}" Style="{DynamicResource TextBlockWithMargin}"/>
                    <TextBlock Text="{Binding CurrentDoctor.Specialisation}" Style="{DynamicResource TextBlockWithMargin}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Grid.Row="1" Style="{DynamicResource BorderWithMargin}">
            <ListView ItemsSource="{Binding Pacients}" SelectedItem="{Binding SelectedPacient}" Style="{DynamicResource ListViewBackground}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="Идентификатор: " Style="{DynamicResource TextBlockWithMargin}"/>
                                <TextBlock Text="Фамилия: " Style="{DynamicResource TextBlockWithMargin}"/>
                                <TextBlock Text="Имя: " Style="{DynamicResource TextBlockWithMargin}"/>
                                <TextBlock Text="Отчество: " Style="{DynamicResource TextBlockWithMargin}"/>
                                <TextBlock Text="Дата рождения: " Style="{DynamicResource TextBlockWithMargin}"/>
                                <TextBlock Text="Номер телефона: " Style="{DynamicResource TextBlockWithMargin}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding ID}" Style="{DynamicResource TextBlockWithMargin}"/>
                                <TextBlock Text="{Binding LastName}" Style="{DynamicResource TextBlockWithMargin}"/>
                                <TextBlock Text="{Binding Name}" Style="{DynamicResource TextBlockWithMargin}"/>
                                <TextBlock Text="{Binding MiddleName}" Style="{DynamicResource TextBlockWithMargin}"/>
                                <TextBlock Text="{Binding Birthday, StringFormat=' {0:dd.MM.yyyy}'}" Style="{DynamicResource TextBlockWithMargin}"/>
                                <TextBlock Text="{Binding PhoneNumber}" Style="{DynamicResource TextBlockWithMargin}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="2" Style="{DynamicResource StackPanelBackground}">
            <Label Content="Всего в списке:"/>
            <Label Content="{Binding Pacients.Count}"/>
        </StackPanel>
    </Grid>
</Page>