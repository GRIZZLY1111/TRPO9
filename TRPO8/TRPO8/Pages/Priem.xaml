<Page x:Class="TRPO8.Pages.Priem"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TRPO8.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Priem" Background="{DynamicResource WindowBackground}">

    <Page.Resources>
        <Style TargetType="Label">
            <Setter Property="Margin" Value="0.7"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="400"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.Row="0" Width="310" Style="{StaticResource BorderWithMargin}">
            <StackPanel Orientation="Horizontal">
                <StackPanel>
                    <Label Content="Идентификатор:"/>
                    <Label Content="Фамилия:"/>
                    <Label Content="Имя:"/>
                    <Label Content="Отчество:"/>
                    <Label Content="Дата рождения:"/>
                    <Label Content="Номер телефона:"/>
                    <Label Content="Посещение: "/>
                    <Label Content="Индентификатор доктора: "/>
                    <Label Content="Диагноз: "/>
                    <Label Content="Рекомендации: "/>
                    <Button Click="ZapisPacientButton_Click" Content="Записать прием" Style="{StaticResource StandardButton}"/>
                    <Button Click="IzmeneniePacientButton_Click" Content="Изменить информацию" Style="{StaticResource StandardButton}"/>
                    <Button Click="BackButton_Click" Content="Назад" Style="{StaticResource StandardButton}"/>
                </StackPanel>
                <StackPanel>
                    <TextBox Text="{Binding ZapisPacient.ID}" Width="140" Style="{StaticResource TextBoxWithMargin}" IsEnabled="False"/>
                    <TextBox Text="{Binding ZapisPacient.LastName}" Style="{StaticResource TextBoxWithMargin}" IsEnabled="False"/>
                    <TextBox Text="{Binding ZapisPacient.Name}" Style="{StaticResource TextBoxWithMargin}" IsEnabled="False"/>
                    <TextBox Text="{Binding ZapisPacient.MiddleName}" Style="{StaticResource TextBoxWithMargin}" IsEnabled="False"/>
                    <DatePicker SelectedDate="{Binding ZapisPacient.Birthday}" IsEnabled="False"/>
                    <TextBox Text="{Binding ZapisPacient.PhoneNumber}" Style="{StaticResource TextBoxWithMargin}" IsEnabled="False"/>
                    <DatePicker SelectedDate="{Binding Appointment}"/>
                    <TextBox Text="{Binding CurrentDoctor.ID}" Style="{StaticResource TextBoxWithMargin}" IsEnabled="False"/>
                    <TextBox Text="{Binding Diagnosis}" Style="{StaticResource TextBoxWithMargin}"/>
                    <TextBox Text="{Binding Recomendations}" Style="{StaticResource TextBoxWithMargin}"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource BorderWithMargin}">
            <ListView ItemsSource="{Binding Posechenia}" SelectedItem="{Binding SelectedPacient}" Style="{DynamicResource ListViewBackground}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock Text="Посещение: " Style="{StaticResource TextBlockWithMargin}"/>
                                <TextBlock Text="Индентификатор доктора: " Style="{StaticResource TextBlockWithMargin}"/>
                                <TextBlock Text="Диагноз: " Style="{StaticResource TextBlockWithMargin}"/>
                                <TextBlock Text="Рекомендации: " Style="{StaticResource TextBlockWithMargin}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Appointment, StringFormat=' {0:dd.MM.yyyy}'}" Style="{StaticResource TextBlockWithMargin}"/>
                                <TextBlock Text="{Binding IDDoctor}" Style="{StaticResource TextBlockWithMargin}"/>
                                <TextBlock Text="{Binding Diagnosis}" Style="{StaticResource TextBlockWithMargin}"/>
                                <TextBlock Text="{Binding Recomendations}" Style="{StaticResource TextBlockWithMargin}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="2" Style="{DynamicResource StackPanelBackground}">
            <Label Content="Посещений:"/>
            <Label Content="{Binding Posechenia.Count}"/>
        </StackPanel>
    </Grid>
</Page>